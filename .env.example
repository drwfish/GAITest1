# ─── Claude / Anthropic Authentication ──────────────────────────────
# Option 1 (recommended for API customers): Your Anthropic API key
ANTHROPIC_API_KEY=

# Option 2 (for Claude Pro/Max subscribers): Setup token from `claude setup-token`
CLAUDE_SETUP_TOKEN=

# ─── Optional: Web Search ──────────────────────────────────────────
# Required if you enable the web-search skill
BRAVE_SEARCH_API_KEY=
